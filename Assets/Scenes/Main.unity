  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2011956580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e78712f5cae76c748bef6b9631ff6f30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DuckMow.ComicSequence
  panels:
  - id: pond
    art: {fileID: 2800000, guid: 14619c898f0508b46ad7ac976238aaed, type: 3}
    duration: 4.2
    moveFrom:
      serializedVersion: 2
      x: 0.02
      y: 0.03
      width: 0.96
      height: 0.96
    moveTo:
      serializedVersion: 2
      x: 0.13
      y: 0.11
      width: 0.76
      height: 0.76
    narration:
    - The pond had always been there. So had the duck.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.9
    emphasis: 0
    sfxId: pond_calm
    placeholderTint: {r: 0.19607843, g: 0.5529412, b: 0.7137255, a: 1}
    placeholderLabel: "THE POND \xB7 FEEDING THE FISH"
  - id: notice
    art: {fileID: 2800000, guid: 151e3635ebf5bc24bad18a6f2316b884, type: 3}
    duration: 4.6
    moveFrom:
      serializedVersion: 2
      x: 0.14
      y: 0.22
      width: 0.72
      height: 0.72
    moveTo:
      serializedVersion: 2
      x: 0.04
      y: 0.03
      width: 0.92
      height: 0.92
    narration:
    - Then came men with paper, a machine, and seven days.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.7
    emphasis: 0.12
    sfxId: sign_thud
    placeholderTint: {r: 0.8745098, g: 0.29411766, b: 0.27058825, a: 1}
    placeholderLabel: "THE NOTICE \xB7 POND TO BE REMOVED"
  - id: shock
    art: {fileID: 2800000, guid: 359444875b41389488a4c29dcb7216ae, type: 3}
    duration: 4
    moveFrom:
      serializedVersion: 2
      x: 0.12
      y: 0.12
      width: 0.8
      height: 0.8
    moveTo:
      serializedVersion: 2
      x: 0.22
      y: 0.2
      width: 0.6
      height: 0.6
    narration:
    - Nobody had asked the duck what the pond was worth.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.7
    emphasis: 0.28
    sfxId: shock_sting
    placeholderTint: {r: 0.9764706, g: 0.6392157, b: 0.19215687, a: 1}
    placeholderLabel: "SHOCK \xB7 THE DUCK'S FACE"
  - id: grief
    art: {fileID: 2800000, guid: 52339dfc284f63245a926ce7fc027515, type: 3}
    duration: 4
    moveFrom:
      serializedVersion: 2
      x: 0.16
      y: 0.06
      width: 0.78
      height: 0.78
    moveTo:
      serializedVersion: 2
      x: 0.05
      y: 0.11
      width: 0.78
      height: 0.78
    narration:
    - And a pond cannot be bought back with breadcrumbs.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 1
    emphasis: 0.18
    sfxId: sad_swell
    placeholderTint: {r: 0.36078432, g: 0.5254902, b: 0.78431374, a: 1}
    placeholderLabel: "GRIEF \xB7 LOOKING OUT OVER THE WATER"
  - id: price
    art: {fileID: 2800000, guid: 2f760b83e3434f34b807cccd29664e44, type: 3}
    duration: 5.8
    moveFrom:
      serializedVersion: 2
      x: 0.02
      y: 0.06
      width: 0.92
      height: 0.92
    moveTo:
      serializedVersion: 2
      x: 0.3
      y: 0.06
      width: 0.56
      height: 0.56
    narration:
    - A pond, it turned out, could be bought.
    - It cost $10,000.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.8
    emphasis: 0.35
    sfxId: window_chime
    placeholderTint: {r: 0.6627451, g: 0.46666667, b: 0.24705882, a: 1}
    placeholderLabel: "THE PRICE \xB7 LAND FOR SALE"
  - id: prize
    art: {fileID: 2800000, guid: 92bdee097defd474db6031976d8baa1e, type: 3}
    duration: 5.8
    moveFrom:
      serializedVersion: 2
      x: 0.02
      y: 0.06
      width: 0.92
      height: 0.92
    moveTo:
      serializedVersion: 2
      x: 0.3
      y: 0.06
      width: 0.56
      height: 0.56
    narration:
    - Then the wind brought him a flyer.
    - 'First prize: $10,000.'
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.8
    emphasis: 0.35
    sfxId: paper_flutter
    placeholderTint: {r: 0.7882353, g: 0.64705884, b: 0.3529412, a: 1}
    placeholderLabel: "THE PRIZE \xB7 CHAMPIONSHIP FLYER"
  - id: realise
    art: {fileID: 2800000, guid: 48a73e657b03eaf41b2e3e6c9aabd2d9, type: 3}
    duration: 4.2
    moveFrom:
      serializedVersion: 2
      x: 0.06
      y: 0.1
      width: 0.84
      height: 0.84
    moveTo:
      serializedVersion: 2
      x: 0.17
      y: 0.17
      width: 0.66
      height: 0.66
    narration:
    - A duck cannot own land. But a duck can tend it.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.8
    emphasis: 0.32
    sfxId: realise_ding
    placeholderTint: {r: 0.627451, g: 0.8235294, b: 0.40784314, a: 1}
    placeholderLabel: "REALISATION \xB7 LOOKING DOWN AT THE FLYER"
  - id: greed
    art: {fileID: 2800000, guid: 2da61637e8abcd4448a56a0fd4b4368e, type: 3}
    duration: 4
    moveFrom:
      serializedVersion: 2
      x: 0.16
      y: 0.16
      width: 0.64
      height: 0.64
    moveTo:
      serializedVersion: 2
      x: 0.25
      y: 0.23
      width: 0.5
      height: 0.5
    narration:
    - It was not greed, he told himself. It was a deposit.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.7
    emphasis: 0.4
    sfxId: cash_sparkle
    placeholderTint: {r: 0.7882353, g: 0.64705884, b: 0.3529412, a: 1}
    placeholderLabel: "GREED \xB7 DOLLAR SIGNS IN THE EYES"
  - id: resolve
    art: {fileID: 2800000, guid: 15e56847b7a3b544f88c5ca76438a0ce, type: 3}
    duration: 4.2
    moveFrom:
      serializedVersion: 2
      x: 0.1
      y: 0.08
      width: 0.78
      height: 0.78
    moveTo:
      serializedVersion: 2
      x: 0.16
      y: 0.13
      width: 0.7
      height: 0.7
    narration:
    - He had never mown so much as a verge in his life.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 0.8
    emphasis: 0.45
    sfxId: resolve_drum
    placeholderTint: {r: 0.8666667, g: 0.24705882, b: 0.21960784, a: 1}
    placeholderLabel: "RESOLVE \xB7 JAW SET, WINGS CLENCHED"
  - id: shed
    art: {fileID: 2800000, guid: a71bd99bd9be6bb4c9593f66275ae258, type: 3}
    duration: 5
    moveFrom:
      serializedVersion: 2
      x: 0.21
      y: 0.17
      width: 0.6
      height: 0.6
    moveTo:
      serializedVersion: 2
      x: 0.02
      y: 0.02
      width: 0.94
      height: 0.94
    narration:
    - The mower was older than he was.
    - Seven days left. He pulled the cord.
    narrationHold: []
    narrationVoice: []
    transition: 1
    transitionDuration: 1.1
    emphasis: 0.5
    sfxId: shed_door
    placeholderTint: {r: 0.2901961, g: 0.30980393, b: 0.33333334, a: 1}
    placeholderLabel: "THE SHED \xB7 WALKING TO THE MOWER"
