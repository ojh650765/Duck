  m_Script: {fileID: 11500000, guid: 5c126d401668249438aa79f96fd16a8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DuckMow.JudgePanel
  judges:
  - displayName: MILDRED
    species: goat
    bias: 0
    character: {fileID: 1386038378}
    severity: 1.45
    ceiling: 10
    floor: 0
    deliberationSeconds: 2
    quipGreat: ...Acceptable. Barely. Well done.
    quipGood: The left edge wandered. I noticed. I always notice.
    quipOkay: It is a shape. I will grant you that much.
    quipBad: I have seen a goat do better. I was that goat.
  - displayName: BORIS
    species: badger
    bias: 1
    character: {fileID: 322553488}
    severity: 0.72
    ceiling: 10
    floor: 2
    deliberationSeconds: 0.9
    quipGreat: MAGNIFICENT! I felt something in my chest!
    quipGood: Loads of grass cut! Loads! Marvellous stuff!
    quipOkay: Bold! Confusing! But bold!
    quipBad: You tried. That is the main thing. Truly.
  - displayName: PRISCILLA
    species: heron
    bias: 2
    character: {fileID: 1531957420}
    severity: 1.25
    ceiling: 9
    floor: 0
    deliberationSeconds: 2.6
    quipGreat: I award nine. I have never awarded ten. Do not ask.
    quipGood: Competent line work. Unremarkable, but competent.
    quipOkay: The outline and I are no longer speaking.
    quipBad: No.
  leadIn: 0.7
  betweenJudges: 0.55
  holdAfterLast: 1.5
